# Copy to .env and replace every placeholder before running docker compose.

# --- PostgreSQL ---
POSTGRES_DB=reconvault
POSTGRES_USER=reconvault
# URL-safe characters only (it is embedded in DATABASE_URL).
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-use-openssl-rand-hex-24
# disable | require | verify-full (use TLS for remote databases)
POSTGRES_SSLMODE=disable
DB_MAX_CONNS=10

# --- API ---
# Bearer token required on all /api/v1 endpoints; at least 32 characters.
# Generate with: openssl rand -hex 32
API_KEY=change-me-use-openssl-rand-hex-32-xxxxxxxxxxxx
LOG_LEVEL=info

# --- HTTP request module ---
UPSTREAM_TIMEOUT=30s
# Maximum incoming API request body (bytes).
MAX_REQUEST_BYTES=2097152
# Maximum stored upstream response body (bytes); larger bodies are truncated.
MAX_RESPONSE_BODY_BYTES=10485760
# SSRF protection: keep false in production. true allows requests to
# loopback, private (RFC 1918), link-local and other non-public addresses.
ALLOW_PRIVATE_NETWORKS=false
SHUTDOWN_TIMEOUT=15s

# --- Entrypoint (dashboard + API on one host) ---
# Host interface and port of the nginx entrypoint, which serves the dashboard
# at / and proxies the API at /api/v1. 0.0.0.0 = every host interface.
APP_BIND=0.0.0.0
APP_PORT=8080

# --- DNS autoscan (reconvault-dns-autoscan) ---
# Recursive resolvers, ip[:port], comma-separated. Records are read from the
# zones' authoritative nameservers; these are used to find them and as a
# fallback.
DNS_RESOLVERS=1.1.1.1:53,8.8.8.8:53,9.9.9.9:53
DNS_TIMEOUT=5s
DNS_RETRIES=2
# Interval between the starts of active passes; the daily refresh runs at
# 00:00 UTC.
AUTOSCAN_ACTIVE_INTERVAL=1m
AUTOSCAN_BATCH_SIZE=100
AUTOSCAN_CONCURRENCY=16
AUTOSCAN_HTTP_PROBE_TIMEOUT=10s
AUTOSCAN_DB_MAX_CONNS=10
AUTOSCAN_SHUTDOWN_TIMEOUT=30s
